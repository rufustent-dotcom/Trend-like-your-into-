# GOOGLE_API_KEY / GEMINI_API_KEY: Required for Gemini AI and Deep Research Interactions API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or paid model flow.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# STRIPE_SECRET_KEY: Required for Stripe payment processing.
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"

# STRIPE_WEBHOOK_SECRET: Signing secret for verifying Stripe webhook events.
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_STRIPE_PUBLISHABLE_KEY: Required for Stripe client-side.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
